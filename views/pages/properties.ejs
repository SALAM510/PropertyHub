<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PropertyHub</title>
    <link rel="stylesheet" href="/styles/properties.css">
    <link rel="shortcut icon" href="/images/logo.avif" type="image/x-icon">
</head>
<body>

<%- include("../partials/navbar") %>

<div id="properties-page">
    <% if (!isSearch || properties.length> 0) { %>
        <div id="properties-heading">
            <h1>Properties</h1>
            <p>
                Find a property that fits your needs.
            </p>
        </div>
        <% } %>

<div id="property-search">
    <div id="property-search-tabs">
        <button type="button" class="property-search-tab active" data-type="buy">
            BUY
        </button>
        <button type="button" class="property-search-tab" data-type="rent">
            RENT
        </button>
    </div>

    <div id="property-search-options">
        <div>
            <label>Location</label>
            <input type="text" id="property-location" placeholder="Enter location">
        </div>

        <div>
            <label>Property Type</label>
            <select id="property-type">
                <option value="">Property Type</option>
                <option value="house">House</option>
                <option value="Penthouse">Penthouse</option>
                <option value="Duplex">Duplex</option>
                <option value="Detached Duplex">Detached Duplex</option>
                <option value="Semi Detached Duplex">Semi Detached Duplex</option>
                <option value="Bungalow">Bungalow</option>
                <option value="Detached Bungalow">Detached Bungalow</option>
                <option value="Semi Detached Bungalow">Semi Detached Bungalow</option>
                <option value="Terrace">Terrace</option>
                <option value="Hostels">Hostels</option>
                <option value="Self Conatin">Self Conatin</option>
                <option value="Maisonette">Maisonette</option>
            </select>
        </div>

        <div>
            <label>Minimum Price</label>
            <select id="property-min-price">
                <option value="">Minimum Price</option>
                <option value="10000000">10,000,000</option>
                <option value="20000000">20,000,000</option>
                <option value="30000000">30,000,000</option>
                <option value="50000000">50,000,000</option>
                <option value="100000000">100,000,000</option>
                <option value="200000000">200,000,000</option>
                <option value="500000000">500,000,000</option>
                <option value="1000000000">1,000,000,000</option>
                <option value="5000000000">5,000,000,000</option>
            </select>
        </div>

        <div>
            <label>Maximum Price</label>
            <select id="property-max-price">
                <option value="">Maximum Price</option>
                <option value="10000000">10,000,000</option>
                <option value="20000000">20,000,000</option>
                <option value="30000000">30,000,000</option>
                <option value="50000000">50,000,000</option>
                <option value="100000000">100,000,000</option>
                <option value="200000000">200,000,000</option>
                <option value="500000000">500,000,000</option>
                <option value="1000000000">1,000,000,000</option>
                <option value="5000000000">5,000,000,000</option>
            </select>
        </div>

        <button type="button" id="property-search-button">
            Search
        </button>
    </div>
</div>

<div id="property-list">
    <% if (properties.length> 0) { %>
        <% properties.forEach(property=> { %>
            <div class="property">
                <img src="<%= property.images[0] %>" alt="<%= property.title %>">

                <div class="property-info">
                    <% if (property.listingType==="For Rent" ) { %>
                        <p class="listing-type">
                            FOR RENT
                        </p>
                        <% } else if (property.listingType==="For Sale" ) { %>
                            <p class="listing-type">
                                FOR SALE
                            </p>
                            <% } %>

                    <h2>
                        <%= property.title %>
                    </h2>

                    <p class="location">
                        <%= property.city %>,
                        <%= property.state %>
                    </p>

                    <strong>
                        ₦<%= property.price.toLocaleString() %>
                    </strong>

                    <p class="property-details">
                        <%= property.bedrooms %> Bedrooms
                        <%= property.bathrooms %> Bathrooms
                    </p>

                    <p class="description">
                        <%= property.description.substring(0, 100) %>...
                    </p>

                    <a href="/properties-details/<%= property._id %>" class="see-more">
                        See More
                    </a>
                </div>
            </div>
<% }) %>
    <% } else if (isSearch) { %>
        <div class="no-properties">
            <h2>No Properties Found</h2>
            <p>
                We couldn't find any properties matching your search.
            </p>
        </div>
        <% } %>
            </div>
            </div>

        <%- include("../partials/footer") %>

<script>
    const searchTabs = document.querySelectorAll(".property-search-tab");
    const searchButton = document.getElementById("property-search-button");

    let listingType = "For Sale";

    searchTabs.forEach(tab => {
        tab.addEventListener("click", function () {
            searchTabs.forEach(tab => {
                tab.classList.remove("active");
            });

            this.classList.add("active");

            if (this.dataset.type === "buy") {
                listingType = "For Sale";
            } else {
                listingType = "For Rent";
            }
        });
    });

    searchButton.addEventListener("click", function () {
        const location = document.getElementById("property-location").value;
        const propertyType = document.getElementById("property-type").value;
        const minPrice = document.getElementById("property-min-price").value;
        const maxPrice = document.getElementById("property-max-price").value;

        const params = new URLSearchParams();

        params.append("listingType", listingType);

        if (location) {
            params.append("location", location);
        }

        if (propertyType) {
            params.append("propertyType", propertyType);
        }

        if (minPrice) {
            params.append("minPrice", minPrice);
        }

        if (maxPrice) {
            params.append("maxPrice", maxPrice);
        }

        window.location.href = "/properties/search?" + params.toString();
    });
</script>

</body>
</html>