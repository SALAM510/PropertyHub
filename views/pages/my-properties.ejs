<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PropertyHub</title>
    <link rel="stylesheet" href="/styles/my-properties.css">
    <link rel="shortcut icon" href="/images/logo.avif" type="image/x-icon">
</head>
<body>

<%- include("../partials/navbar") %>

<div id="my-properties-page">
    <div id="my-properties-heading">
        <h1>
            My Properties
        </h1>
        <p>
            Manage your properties
        </p>
    </div>

    <div id="posted-properties">
        <div id="property-list">
            <p id="loading">
                Loading your properties...
            </p>
        </div>
    </div>
</div>

<%- include("../partials/footer") %>

<script>
    const userToken =
        localStorage.getItem("token");

    if (!userToken) {
        window.location.href = "/login";
    }

    async function getMyProperties() {
        const propertyList =
            document.getElementById(
                "property-list"
            );

        try {
            const response =
                await fetch(
                    "/properties/my-properties",
                    {
                        method: "GET",
                        headers: {
                            "Authorization":
                                "Bearer " +
                                userToken
                        }
                    }
                );

            const data =
                await response.json();

            if (!response.ok) {
                throw new Error(
                    data.message ||
                    "Unable to fetch properties"
                );
            }

            propertyList.innerHTML = "";

            const properties =
                data.properties;

            if (
                !properties ||
                properties.length === 0
            ) {
                propertyList.innerHTML = `
                    <p id="no-properties">
                        You have not posted any properties yet.
                    </p>
                `;
                return;
            }

            for (
                const property
                of properties
            ) {
                const formattedPrice =
                    Number(
                        property.price
                    ).toLocaleString();

                propertyList.innerHTML += `
                    <div class="property-card">
                        <div class="property-image">
                            <img
                                src="${property.images[0]}"
                                alt="${property.title}"
                            >
                        </div>

                        <div class="property-content">
                            <h2>
                                ${property.title}
                            </h2>

                            <p class="location">
                                ${property.city},
                                ${property.state}
                            </p>

                            <p class="price">
                                ₦${formattedPrice}
                            </p>

                            <p class="status">
                                Status:
                                <span
                                    class="${property.status}"
                                >
                                    ${property.status}
                                </span>
                            </p>

                            <div class="property-buttons">
                                <button
                                    class="update-btn"
                                    onclick="updateProperty('${property._id}')"
                                >
                                    Update
                                </button>

                                <button
                                    class="delete-btn"
                                    onclick="deleteProperty('${property._id}')"
                                >
                                    Delete
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }
        } catch (error) {
            console.error(error);

            propertyList.innerHTML = `
                <p id="error-message">
                    Unable to load your properties.
                </p>
            `;
        }
    }

    function updateProperty(propertyId) {
        window.location.href =
            "/update-property/" +
            propertyId;
    }

    async function deleteProperty(propertyId) {
        try {
            const response =
                await fetch(
                    "/properties/" +
                    propertyId,
                    {
                        method: "DELETE",
                        headers: {
                            "Authorization":
                                "Bearer " +
                                userToken
                        }
                    }
                );

            const data =
                await response.json();

            if (!response.ok) {
                throw new Error(
                    data.message ||
                    "Unable to delete property"
                );
            }

            getMyProperties();
        } catch (error) {
            console.error(error);

            alert(
                error.message ||
                "Unable to delete property"
            );
        }
    }

    getMyProperties();
</script>

</body>
</html>