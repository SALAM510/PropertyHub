<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PropertyHub</title>
    <link rel="stylesheet" href="/styles/home.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg=="crossorigin="anonymous" referrerpolicy="no-referrer">
</head>

<body>

    <%- include("../partials/navbar") %>

        <div id="home">

            <div id="home-text">

                <h1>
                    Build Your Future,<br>
                    One Property at a Time.
                </h1>

                <p>
                    Find a place you'll love.
                    Discover properties that fit your lifestyle,
                    budget and future.
                </p>

            </div>


            <div id="search">

                <div id="search-tabs">

                    <button type="button" class="searchtab active" data-type="buy">
                        BUY
                    </button>

                    <button type="button" class="searchtab" data-type="rent">
                        RENT
                    </button>

                </div>


                <div id="search-options">

                    <div>

                        <label>Location</label>

                        <input type="text" id="location" placeholder="Enter location">

                    </div>


                    <div>

                        <label>Property Type</label>

                        <select id="propertyType">

                            <option value="">
                                Property Type
                            </option>

                            <option value="house">
                                House
                            </option>

                            <option value="Penthouse">
                                Penthouse
                            </option>

                            <option value="Duplex">
                                Duplex
                            </option>

                            <option value="Detached Duplex">
                                Detached Duplex
                            </option>

                            <option value="Semi Detached Duplex">
                                Semi Detached Duplex
                            </option>

                            <option value="Bungalow">
                                Bungalow
                            </option>

                            <option value="Detached Bungalow">
                                Detached Bungalow
                            </option>

                            <option value="Semi Detached Bungalow">
                                Semi Detached Bungalow
                            </option>

                            <option value="Hotels">
                                Hotels
                            </option>

                            <option value="Hostels">
                                Hostels
                            </option>

                            <option value="Self Conatin">
                                Self Conatin
                            </option>

                        </select>

                    </div>


                    <div>

                        <label>Minimum Price</label>

                        <select id="minPrice">

                            <option value="">
                                Minimum Price
                            </option>

                            <option value="10000000">10,000,000</option>
                            <option value="20000000">20,000,000</option>
                            <option value="30000000">30,000,000</option>
                            <option value="50000000">50,000,000</option>
                            <option value="100000000">100,000,000</option>
                            <option value="200000000">200,000,000</option>
                            <option value="500000000">500,000,000</option>
                            <option value="1000000000">1,000,000,000</option>
                            <option value="5000000000">5,000,000,000</option>

                        </select>

                    </div>


                    <div>

                        <label>Maximum Price</label>

                        <select id="maxPrice">

                            <option value="">
                                Maximum Price
                            </option>

                            <option value="10000000">10,000,000</option>
                            <option value="20000000">20,000,000</option>
                            <option value="30000000">30,000,000</option>
                            <option value="50000000">50,000,000</option>
                            <option value="100000000">100,000,000</option>
                            <option value="200000000">200,000,000</option>
                            <option value="500000000">500,000,000</option>
                            <option value="1000000000">1,000,000,000</option>
                            <option value="5000000000">5,000,000,000</option>

                        </select>

                    </div>


                    <button type="button" id="search-button">
                        Search
                    </button>

                </div>

            </div>

        </div>


        <div id="property-list">

            <div id="property-head">

                <h2>Property List</h2>

                <a href="/properties">
                    See All
                    <i class="fa-solid fa-arrow-right"></i>
                </a>

            </div>


            <div id="properties">

                <div class="property">

                    <img src="/images/semidetached.webp" alt="Property">

                    <h3>Semi Detached Duplex</h3>

                    <p>Lagos, Nigeria</p>

                    <strong>#200,000,000</strong>

                    <p>3 bed 3 baths</p>

                </div>


                <div class="property">

                    <img src="/images/detached.jpeg" alt="Property">

                    <h3>Fully Detached Duplex</h3>

                    <p>Abuja, Nigeria</p>

                    <strong>#200,000,000</strong>

                    <p>4 bed 4 baths</p>

                </div>


                <div class="property">

                    <img src="/images/duplex.jpeg" alt="Property">

                    <h3>Modern Contemporary Duplex</h3>

                    <p>Ibadan, Nigeria</p>

                    <strong>#350,000,000</strong>

                    <p>5 bed 5 baths</p>

                </div>

            </div>

        </div>


        <div id="ratings">

            <div>

                <i class="fa-solid fa-circle-check"></i>

                <h2>100%</h2>

                <p>Clients Satisfaction</p>

            </div>


            <div>

                <i class="fa-solid fa-house"></i>

                <h2>500+</h2>

                <p>Properties Listed</p>

            </div>


            <div>

                <i class="fa-solid fa-location-dot"></i>

                <h2>100+</h2>

                <p>Cities & Locations</p>

            </div>


            <div>

                <i class="fa-solid fa-star"></i>

                <h2>2,000+</h2>

                <p>Positive Reviews</p>

            </div>

        </div>


        <%- include("../partials/footer") %>

<script>

    const searchTabs = document.querySelectorAll(".searchtab");

    const searchButton = document.getElementById("search-button");

    let listingType = "buy";


    searchTabs.forEach(tab => {

        tab.addEventListener("click", function () {

            searchTabs.forEach(tab => {
                tab.classList.remove("active");
            });

            this.classList.add("active");

            listingType = this.dataset.type;

        });

    });


    searchButton.addEventListener("click", function () {

        if (listingType === "buy") {

            window.location.href = "/properties/buy";

        }

        if (listingType === "rent") {

            window.location.href = "/properties/rent";

        }

    });

</script>

</body>
</html>