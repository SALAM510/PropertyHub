<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PropertyHub</title>
    <link rel="stylesheet" href="/styles/profile.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="shortcut icon" href="/images/logo.avif" type="image/x-icon">
</head>
<body>

    <%- include("../partials/navbar") %>

        <div id="profile-page">
            <div id="profile-box">
                <h1>My Profile</h1>

                <div class="profile-item">
                    <label>Name</label>
                    <p id="user-name">Loading...</p>
                </div>

                <div class="profile-item">
                    <label>Email</label>
                    <p id="user-email">Loading...</p>
                </div>

                <div class="profile-item">
                    <label>Phone</label>
                    <p id="user-phone">Loading...</p>
                </div>

                <p id="profile-message"></p>

                <div id="profile-buttons">
                    <button id="edit-profile-btn">
                        Edit Profile
                    </button>

                    <button id="save-profile-btn" style="display: none;">
                        Save Changes
                    </button>

                    <button id="cancel-profile-btn" style="display: none;">
                        Cancel
                    </button>

                    <button id="profile-logout-btn">
                        Logout
                    </button>
                </div>
            </div>
        </div>

<%- include("../partials/footer") %>

<script>
    const profileToken = localStorage.getItem("token");
    const profileUserName = document.getElementById("user-name");
    const profileUserEmail = document.getElementById("user-email");
    const profileUserPhone = document.getElementById("user-phone");
    const profileMessage = document.getElementById("profile-message");
    const editProfileBtn = document.getElementById("edit-profile-btn");
    const saveProfileBtn = document.getElementById("save-profile-btn");
    const cancelProfileBtn = document.getElementById("cancel-profile-btn");
    const profileLogoutBtn = document.getElementById("profile-logout-btn");

    let currentUserId = "";
    let currentName = "";
    let currentPhone = "";

    if (!profileToken) {
        window.location.href = "/login";
    }

    async function getProfile() {
        try {
            const response = await fetch("/auth/profile", {
                method: "GET",
                headers: {
                    "Authorization": "Bearer " + profileToken
                }
            });

            const data = await response.json();

            if (!response.ok) {
                localStorage.removeItem("token");
                window.location.href = "/login";
                return;
            }

            currentUserId = data.user._id;
            currentName = data.user.name;
            currentPhone = data.user.phone;

            profileUserName.textContent = data.user.name;
            profileUserEmail.textContent = data.user.email;
            profileUserPhone.textContent = data.user.phone;
        } catch (error) {
            console.error(error);
            profileUserName.textContent = "Unable to load profile";
            profileUserEmail.textContent = "Unable to load profile";
            profileUserPhone.textContent = "Unable to load profile";
        }
    }

    editProfileBtn.addEventListener("click", function () {
        profileUserName.innerHTML = `
            <input
                type="text"
                id="edit-name"
                value="${currentName}"
            >
        `;

        profileUserPhone.innerHTML = `
            <input
                type="text"
                id="edit-phone"
                value="${currentPhone}"
            >
        `;

        editProfileBtn.style.display = "none";
        saveProfileBtn.style.display = "inline-block";
        cancelProfileBtn.style.display = "inline-block";
        profileMessage.textContent = "";
    });

    cancelProfileBtn.addEventListener("click", function () {
        profileUserName.textContent = currentName;
        profileUserPhone.textContent = currentPhone;

        editProfileBtn.style.display = "inline-block";
        saveProfileBtn.style.display = "none";
        cancelProfileBtn.style.display = "none";
        profileMessage.textContent = "";
    });

    saveProfileBtn.addEventListener("click", async function () {
        const nameInput = document.getElementById("edit-name");
        const phoneInput = document.getElementById("edit-phone");

        const name = nameInput.value.trim();
        const phone = phoneInput.value.trim();

        profileMessage.textContent = "";

        if (!name || !phone) {
            profileMessage.textContent =
                "Name and phone are required.";
            return;
        }

        try {
            const response = await fetch(
                "/auth/user/" + currentUserId,
                {
                    method: "PUT",
                    headers: {
                        "Content-Type": "application/json",
                        "Authorization": "Bearer " + profileToken
                    },
                    body: JSON.stringify({
                        name: name,
                        phone: phone
                    })
                }
            );

            const data = await response.json();

            if (!response.ok) {
                profileMessage.textContent =
                    data.message ||
                    "Unable to update profile.";
                return;
            }

            currentName = data.user.name;
            currentPhone = data.user.phone;

            profileUserName.textContent = data.user.name;
            profileUserPhone.textContent = data.user.phone;

            localStorage.setItem("name", data.user.name);

            editProfileBtn.style.display = "inline-block";
            saveProfileBtn.style.display = "none";
            cancelProfileBtn.style.display = "none";

            profileMessage.textContent =
                "Profile updated successfully.";

            setTimeout(function () {
                profileMessage.textContent = "";
            }, 5000);

        } catch (error) {
            console.error(error);

            profileMessage.textContent =
                "Unable to update profile. Please try again.";
        }
    });

    profileLogoutBtn.addEventListener("click", function () {
        localStorage.removeItem("token");
        window.location.href = "/";
    });

    getProfile();
</script>

</body>
</html>